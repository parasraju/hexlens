{
  "name": "hexlens",
  "version": "0.6.0",
  "description": "Open Source Binary Intelligence & Reverse Engineering Framework",
  "homepage": "https://github.com/parasraju/hexlens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parasraju/hexlens.git"
  },
  "bugs": {
    "url": "https://github.com/parasraju/hexlens/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "hexlens": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --format cjs --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "binary",
    "reverse-engineering",
    "malware-analysis",
    "pe",
    "elf",
    "macho",
    "dex",
    "dotnet",
    "imphash",
    "security",
    "forensics",
    "triage",
    "batch-scan",
    "tui",
    "yara",
    "threat-hunting",
    "binary-diff",
    "binary-diffing"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "libyara-wasm": "^1.2.1",
    "terminal-kit": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/terminal-kit": "^2.5.7",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
